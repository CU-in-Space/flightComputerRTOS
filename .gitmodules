[submodule "lib/FreeRTOS-Kernel"]
	path = lib/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "lib/cmsis_core"]
	path = lib/cmsis_core
	url = https://github.com/STMicroelectronics/cmsis_core.git
[submodule "lib/cmsis_device_h7"]
	path = lib/cmsis_device_h7
	url = https://github.com/STMicroelectronics/cmsis_device_h7.git
[submodule "lib/stm32h7xx_hal_driver"]
	path = lib/stm32h7xx_hal_driver
	url = https://github.com/STMicroelectronics/stm32h7xx_hal_driver.git
[submodule "lib/fatfs"]
	path = lib/fatfs
	url = https://github.com/STMicroelectronics/stm32_mw_fatfs.git
[submodule "lib/sx126x_driver"]
	path = lib/sx126x_driver
	url = https://github.com/Lora-net/sx126x_driver.git
