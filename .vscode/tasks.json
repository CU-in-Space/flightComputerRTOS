{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (debug)",
      "type": "shell",
      "command": "cmake --build --preset debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (release)",
      "type": "shell",
      "command": "cmake --build --preset release",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "cmake -E rm -rf build",
      "problemMatcher": []
    },
    {
      // Same as the README's flash command: builds first, then programs,
      // verifies and resets.
      "label": "Flash (debug)",
      "type": "shell",
      "command": "cmake --build --preset debug --target flash",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash (release)",
      "type": "shell",
      "command": "cmake --build --preset release --target flash",
      "problemMatcher": ["$gcc"]
    },
    {
      // Restart whatever is on the chip without reflashing.
      "label": "Reset board",
      "type": "shell",
      "command": "openocd -f openocd/nucleo-h753zi.cfg -c init -c \"reset run\" -c shutdown",
      "problemMatcher": []
    }
  ]
}
