{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (debug)",
      "type": "shell",
      "command": "cmake --build --preset debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (release)",
      "type": "shell",
      "command": "cmake --build --preset release",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "cmake -E rm -rf build",
      "problemMatcher": []
    },
    {
      "label": "Flash (OpenOCD)",
      "type": "shell",
      "command": "openocd -f openocd/nucleo-h753zi.cfg -c \"program build/debug/cuis-fc.elf verify reset exit\"",
      "dependsOn": "Build (debug)",
      "problemMatcher": []
    }
  ]
}
