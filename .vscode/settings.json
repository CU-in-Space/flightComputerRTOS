{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,

  // --- IntelliSense -------------------------------------------------------
  // clangd and the cpptools engine both installed = duplicate, contradictory
  // squiggles. clangd wins here (better cross-referencing on embedded code),
  // so the cpptools engine is switched off. cpptools stays installed because
  // cortex-debug's disassembly and some views still use it.
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/debug",
    "--query-driver=/opt/homebrew/opt/gcc-arm-none-eabi/bin/arm-none-eabi-*",
    "--header-insertion=never",
    "--background-index"
  ],

  // --- Debug --------------------------------------------------------------
  "cortex-debug.openocdPath": "/opt/homebrew/bin/openocd",
  "cortex-debug.gdbPath": "/opt/homebrew/opt/gcc-arm-none-eabi/bin/arm-none-eabi-gdb",
  "cortex-debug.variableUseNaturalFormat": true,

  "files.associations": { "*.ld": "ld", "*.h": "c", "*.ioc": "ini" },
  "files.exclude": { "**/.DS_Store": true },
  "search.exclude": { "lib/**": true, "build/**": true, "cubemx/**": true }
}
