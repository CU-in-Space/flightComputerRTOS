{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (OpenOCD + ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/cuis-fc.elf",
      "device": "STM32H753ZI",
      "configFiles": [
        "${workspaceFolder}/openocd/nucleo-h753zi.cfg"
      ],
      "runToEntryPoint": "main",
      // Gives the debugger a task list instead of a single bare thread.
      "rtos": "FreeRTOS",
      // Named peripheral registers (ADC1->CR, GPIOB->ODR, ...) in the
      // XPERIPHERALS view. See debug/README.md.
      "svdFile": "${workspaceFolder}/debug/STM32H753.svd",
      // Variables added to the LIVE WATCH view keep updating while the
      // target runs -- handy for ADC readings or task state without halting.
      "liveWatch": { "enabled": true, "samplesPerSecond": 4 },
      "preLaunchTask": "Build (debug)",
      "showDevDebugOutput": "none"
    },
    {
      "name": "Attach (OpenOCD + ST-Link)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/debug/cuis-fc.elf",
      "device": "STM32H753ZI",
      "configFiles": [
        "${workspaceFolder}/openocd/nucleo-h753zi.cfg"
      ],
      "rtos": "FreeRTOS",
      "svdFile": "${workspaceFolder}/debug/STM32H753.svd",
      "liveWatch": { "enabled": true, "samplesPerSecond": 4 },
      "showDevDebugOutput": "none"
    }
  ]
}
